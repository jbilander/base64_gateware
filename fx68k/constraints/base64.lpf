# =====================================================================
# Base64 revC carrier + iCESugar-Pro v1.3 (LFE5U-25F-6BG256C)
# Auto-generated from Base64.net + iCESugar-Pro v1.3 netlist annotations
# All I/O banks on the module are powered at 3.3 V
# =====================================================================
BLOCK RESETPATHS;
BLOCK ASYNCPATHS;
SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=38.8 SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=ENABLE SLAVE_PARALLEL_PORT=DISABLE;

# ---------------- Clocks ----------------
# 7.09/7.16 MHz motherboard clock, buffered by 74LVC1G17 (PT27A, PCLKT0_1)
LOCATE COMP "clk_7m"   SITE "C7";
IOBUF  PORT "clk_7m"   IO_TYPE=LVCMOS33 PULLMODE=NONE;
FREQUENCY PORT "clk_7m" 7.20 MHz;
# ICS570B x12 = 85.13 (PAL) / 85.91 (NTSC) MHz (PL26A, PCLKT6_1)
LOCATE COMP "clk_12x"  SITE "L1";
IOBUF  PORT "clk_12x"  IO_TYPE=LVCMOS33 PULLMODE=NONE;
FREQUENCY PORT "clk_12x" 86.00 MHz;
# On-module 25 MHz oscillator (PL47C, dedicated GPLL0 input, always available)
LOCATE COMP "clk_25m"  SITE "P6";
IOBUF  PORT "clk_25m"  IO_TYPE=LVCMOS33 PULLMODE=NONE;
FREQUENCY PORT "clk_25m" 25.00 MHz;

