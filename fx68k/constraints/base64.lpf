# ---------------- Module RGB LED (common anode 3V3, drive LOW to light) & UART to iCELink USB-CDC ----------------
LOCATE COMP "led_r_n" SITE "B11";
LOCATE COMP "led_g_n" SITE "A11";
LOCATE COMP "led_b_n" SITE "A12";
IOBUF PORT "led_r_n" IO_TYPE=LVCMOS33; IOBUF PORT "led_g_n" IO_TYPE=LVCMOS33; IOBUF PORT "led_b_n" IO_TYPE=LVCMOS33;
# NOTE: module nets named from MCU perspective: ball A9 = MCU TX -> FPGA RX, B9 = MCU RX -> FPGA TX
LOCATE COMP "uart_rx" SITE "A9";
LOCATE COMP "uart_tx" SITE "B9";
IOBUF PORT "uart_rx" IO_TYPE=LVCMOS33 PULLMODE=UP; IOBUF PORT "uart_tx" IO_TYPE=LVCMOS33;
