# ---------------- On-module SD card slot ----------------
LOCATE COMP "sd_clk" SITE "J12";
LOCATE COMP "sd_cmd" SITE "H12";
LOCATE COMP "sd_d[0]" SITE "K12";
LOCATE COMP "sd_d[1]" SITE "L12";
