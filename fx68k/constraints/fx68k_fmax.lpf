BLOCK RESETPATHS;
BLOCK ASYNCPATHS;
SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=38.8;

LOCATE COMP "clk_25m" SITE "P6";
IOBUF  PORT "clk_25m" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25m" 25.0 MHz;

# The number that matters: PAR must meet this for EN_SPACING=1 (42.5 MHz
# effective) to be viable as-is.
FREQUENCY NET "clk_sys" 85.0 MHz;

LOCATE COMP "led_r_n" SITE "B11";
LOCATE COMP "led_g_n" SITE "A11";
LOCATE COMP "led_b_n" SITE "A12";
IOBUF PORT "led_r_n" IO_TYPE=LVCMOS33;
IOBUF PORT "led_g_n" IO_TYPE=LVCMOS33;
IOBUF PORT "led_b_n" IO_TYPE=LVCMOS33;

# --- Documented fx68k multicycle relaxations (fredrequin/ijor timing notes) ---
# Enable AFTER a first baseline run; verify cell names against the Synplify
# netlist first (they may carry hierarchy prefixes).
# MULTICYCLE FROM CELL "*Ir*" TO CELL "*microAddr*" 2 X;
# MULTICYCLE FROM CELL "*Ir*" TO CELL "*nanoAddr*" 2 X;
